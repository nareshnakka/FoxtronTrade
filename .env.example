# Copy this file to .env and fill values from https://developers.kite.trade
# Never commit .env or share these values in chat.

KITE_API_KEY=
KITE_API_SECRET=

# Prefer :5050. If Zerodha app is stuck on :5000, leave it — app.py forwards
# http://127.0.0.1:5000/callback → http://127.0.0.1:5050/callback automatically.
KITE_REDIRECT_URL=http://127.0.0.1:5050/callback
# Also OK if Kite app Redirect URL is: http://127.0.0.1:5000/callback

# Tokens expire daily ~6 AM IST. Dashboard prompts for login when stale/expired;
# you can also run: python login.py
#
# === Unattended 24×7 (required so you don't login every morning) ===
# From Kite app: User ID + password + TOTP secret (base32 from authenticator setup)
KITE_USER_ID=
KITE_PASSWORD=
KITE_TOTP_SECRET=
