# Copy this file to .env (same folder as app.py) and fill values.
# Never commit .env — keep it local on each PC.

KITE_API_KEY=
KITE_API_SECRET=

# Prefer :5050. If Zerodha app Redirect URL is stuck on :5000, that is OK —
# app.py forwards http://127.0.0.1:5000/callback → :5050/callback.
KITE_REDIRECT_URL=http://127.0.0.1:5050/callback

# === Required for one-click Login + daily 09:00 auto-login ===
# Zerodha user id, password, and TOTP secret (base32 from authenticator setup).
# Do not wrap values in quotes unless the password itself contains spaces.
KITE_USER_ID=
KITE_PASSWORD=
KITE_TOTP_SECRET=
